#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/common.sh"

"${SCRIPT_DIR}/build-android-development"
run_unity build-android-development-en \
  -executeMethod PequenoExplorador.Editor.BuildTools.BuildToolsCli.BuildAndroidDevelopment \
  -startupLocale en \
  -buildPath "${ARTIFACTS_DIR}/builds/PequenoExplorador-development-en.apk"
