  m_TableData:
  - m_Id: 116383744
    m_Localized: "DIAGN\xD3STICO TEMPORAL \xB7 SIN GAMEPLAY"
    m_Metadata:
      m_Items: []
  - m_Id: 116383745
    m_Localized: "Preparando la aventura\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 116383746
    m_Localized: Listo
    m_Metadata:
      m_Items: []
  - m_Id: 116383747
    m_Localized: "Listo \xB7 Recuperamos tu progreso"
    m_Metadata:
      m_Items: []
  - m_Id: 116383748
    m_Localized: "Listo \xB7 Tu progreso nuevo est\xE1 protegido"
    m_Metadata:
      m_Items: []
  - m_Id: 116383749
    m_Localized: "No pudimos iniciar \xB7 Puedes intentar otra vez"
    m_Metadata:
      m_Items: []
  - m_Id: 116383750
    m_Localized: Pausado
    m_Metadata:
      m_Items: []
  - m_Id: 116383751
    m_Localized: "No pudimos cambiar de lugar \xB7 Puedes intentar otra vez"
    m_Metadata:
      m_Items: []
  - m_Id: 116383752
    m_Localized: "Preparando {0}\u2026"
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 116383753
    m_Localized: Ir a la selva
    m_Metadata:
      m_Items: []
  - m_Id: 116383754
    m_Localized: Volver al campamento
    m_Metadata:
      m_Items: []
  - m_Id: 116383755
    m_Localized: Intentar otra vez
    m_Metadata:
      m_Items: []
  - m_Id: 116383756
    m_Localized: Simular fallo
    m_Metadata:
      m_Items: []
  - m_Id: 116383757
    m_Localized: "Espa\xF1ol"
    m_Metadata:
      m_Items: []
  - m_Id: 116383758
    m_Localized: "Ingl\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 116383759
    m_Localized: Pseudo
    m_Metadata:
      m_Items: []
  - m_Id: 23092213571600
    m_Localized: Pausa tranquila
    m_Metadata:
      m_Items: []
  - m_Id: 23092213571601
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 49203240755200
    m_Localized: "Este lugar todav\xEDa no est\xE1 disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 49203265921024
    m_Localized: "Este lugar ya no est\xE1 disponible. Tu progreso sigue seguro."
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000001
    m_Localized: Vamos a acercarnos.
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000002
    m_Localized: Mirar de cerca
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000003
    m_Localized: Ahora no
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000004
    m_Localized: "Todav\xEDa no podemos mirar esto. Probemos con otra cosa."
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000005
    m_Localized: "\xA1Lo vimos de cerca!"
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000006
    m_Localized: Esperemos un momento para volver a mirar.
    m_Metadata:
      m_Items: []
  - m_Id: 77211267751936
    m_Localized: "\xA1Nuevo descubrimiento!"
    m_Metadata:
      m_Items: []
  - m_Id: 77211284529152
    m_Localized: "\xA1Lo observaste otra vez!"
    m_Metadata:
      m_Items: []
  - m_Id: 77211284529153
    m_Localized: "{0} \xB7 Observaciones: {1}"
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 197791753166848
    m_Localized: Vamos a tomar una foto.
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721280
    m_Localized: "Ac\xE9rcate un poquito."
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721281
    m_Localized: "Pon al tuc\xE1n dentro del marco."
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721282
    m_Localized: "\xA1Listo para la foto!"
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721283
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721284
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721285
    m_Localized: Casi. Probemos desde otro lugar.
    m_Metadata:
      m_Items: []
  - m_Id: 197791790915584
    m_Localized: "\xA1Nuevo descubrimiento!"
    m_Metadata:
      m_Items: []
  - m_Id: 197791790915585
    m_Localized: "\xA1Qu\xE9 buena observaci\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 197791790915586
    m_Localized: "\xA1Descubrimiento guardado! Usaremos su ilustraci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 210606312382464
    m_Localized: "\xC1lbum"
    m_Metadata:
      m_Items: []
  - m_Id: 210606345936896
    m_Localized: "\xC1lbum de la Selva"
    m_Metadata:
      m_Items: []
  - m_Id: 210606345936897
    m_Localized: Volver
    m_Metadata:
      m_Items: []
  - m_Id: 210606345936898
    m_Localized: Por descubrir
    m_Metadata:
      m_Items: []
  - m_Id: 210606350131200
    m_Localized: Explora la selva para encontrarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325504
    m_Localized: Descubierto
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325505
    m_Localized: '{0}: {1} de {2}'
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 210606354325506
    m_Localized: 'Encontrados: {0} de {1}'
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 210606354325507
    m_Localized: "Preparando el \xE1lbum\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325508
    m_Localized: "Todav\xEDa no hay entradas aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325509
    m_Localized: "No pudimos abrir esta p\xE1gina. Puedes volver e intentar otra
      vez."
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325510
    m_Localized: "P\xE1gina {0} de {1}"
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 210606354325511
    m_Localized: Anterior
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325512
    m_Localized: Siguiente
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325513
    m_Localized: "D\xF3nde vive"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325514
    m_Localized: "Qu\xE9 come"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325515
    m_Localized: "Tama\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325516
    m_Localized: Algo curioso
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325517
    m_Localized: "C\xF3mo suena"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325518
    m_Localized: "Este dato est\xE1 por confirmar."
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325519
    m_Localized: Escuchar otra vez
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325520
    m_Localized: Audio por preparar
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325521
    m_Localized: "Buscando tu mejor foto\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325522
    m_Localized: "Usamos su imagen del \xE1lbum."
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325523
    m_Localized: Tu mejor foto
    m_Metadata:
      m_Items: []
  - m_Id: 219424916234240
    m_Localized: "Estrellas virtuales \xB7 se ganan jugando y no se compran"
    m_Metadata:
      m_Items: []
  - m_Id: 219424933011456
    m_Localized: DEBUG +1 estrella
    m_Metadata:
      m_Items: []
  - m_Id: 219424933011457
    m_Localized: "Todav\xEDa faltan algunas estrellas. Podemos seguir explorando."
    m_Metadata:
      m_Items: []
  - m_Id: 229917819133952
    m_Localized: "La foto del tuc\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 229917835911168
    m_Localized: "Busca al tuc\xE1n y toma una foto."
    m_Metadata:
      m_Items: []
  - m_Id: 229917835911169
    m_Localized: "Fotograf\xEDa al tuc\xE1n pico canoa"
    m_Metadata:
      m_Items: []
  - m_Id: 229917835911170
    m_Localized: "\xA1Misi\xF3n completa! El tuc\xE1n qued\xF3 en tu \xE1lbum."
    m_Metadata:
      m_Items: []
  - m_Id: 229917835911171
    m_Localized: "Comenzar misi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 229917835911172
    m_Localized: '{0}: {1} de {2}'
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 229917835911173
    m_Localized: "Primero terminemos otra misi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 241337868738560
    m_Localized: Mira y encuentra
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515776
    m_Localized: "Toca el c\xEDrculo como el del ejemplo."
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515777
    m_Localized: "\xA1Lo encontraste!"
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515778
    m_Localized: Miremos otra vez. Puedes probar de nuevo.
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515779
    m_Localized: Busca la forma redonda.
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515780
    m_Localized: No tiene puntas.
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515781
    m_Localized: "Este es el c\xEDrculo. Puedes tocarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515782
    m_Localized: "C\xEDrculo"
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515783
    m_Localized: "Tri\xE1ngulo"
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515784
    m_Localized: Cuadrado
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515785
    m_Localized: Observar y relacionar formas
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515786
    m_Localized: Pista
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515787
    m_Localized: Escuchar otra vez
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515788
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515789
    m_Localized: Puedes volver cuando quieras.
    m_Metadata:
      m_Items: []
  - m_Id: 251180197339136
    m_Localized: "Vamos a descubrir qu\xE9 le gusta comer."
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310656
    m_Localized: "\xBFQu\xE9 elegir\xEDa el tuc\xE1n?"
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310657
    m_Localized: "Toca lo que el tuc\xE1n come sobre todo."
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310658
    m_Localized: "\xA1Buena observaci\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310659
    m_Localized: "El tuc\xE1n mira con curiosidad. Probemos otra opci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310660
    m_Localized: Busca algo que crece en una planta.
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310661
    m_Localized: Es algo jugoso que tiene semillas.
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310662
    m_Localized: Puedes probar la fruta.
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310663
    m_Localized: Fruta
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310664
    m_Localized: Piedra
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310665
    m_Localized: Sombrero
    m_Metadata:
      m_Items: []
  - m_Id: 251180218310666
    m_Localized: "Relacionar animales con su alimentaci\xF3n principal"
    m_Metadata:
      m_Items: []
  - m_Id: 252953859448832
    m_Localized: "Descubrir qu\xE9 come"
    m_Metadata:
      m_Items: []
  - m_Id: 261701088829440
    m_Localized: "Campamento de exploraci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800960
    m_Localized: "Mapa de expedici\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800961
    m_Localized: Elige la Selva y sal a explorar.
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800962
    m_Localized: "\xC1lbum"
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800963
    m_Localized: Mira los descubrimientos que encontraste.
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800964
    m_Localized: "Rinc\xF3n del explorador"
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800965
    m_Localized: "Elige c\xF3mo se ve tu explorador."
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800966
    m_Localized: Para personas adultas
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800967
    m_Localized: "Pr\xF3ximamente, con acceso adulto seguro."
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800968
    m_Localized: "Rinc\xF3n de observaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800969
    m_Localized: "Una mejora visual para tu mesa de exploraci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800970
    m_Localized: "Convierte la mesa en un rinc\xF3n acogedor para recordar lo descubierto."
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800971
    m_Localized: 'Costo: {0:plural:una estrella|{} estrellas}'
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 261701109800972
    m_Localized: Mejorar
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800973
    m_Localized: Ahora no
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800974
    m_Localized: "\xA1Tu rinc\xF3n de observaci\xF3n est\xE1 listo!"
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800975
    m_Localized: "Rinc\xF3n listo"
    m_Metadata:
      m_Items: []
  - m_Id: 261701109800976
    m_Localized: "Esta mejora todav\xEDa no est\xE1 disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 274694803546112
    m_Localized: Mi explorador
    m_Metadata:
      m_Items: []
  - m_Id: 274694820323328
    m_Localized: 'Estrellas disponibles: {0}'
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
