    m_Metadata:
      m_Items: []
  - m_Id: 274694820323330
    m_Localized: Cuesta {0:plural:una estrella|{} estrellas}
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 274694820323331
    m_Localized: Se descubre al mejorar el campamento
    m_Metadata:
      m_Items: []
  - m_Id: 274694820323332
    m_Localized: Desbloquear por {0:plural:una estrella|{} estrellas}
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 274694820323333
    m_Localized: Sigue explorando
    m_Metadata:
      m_Items: []
  - m_Id: 274694820323334
    m_Localized: Usar
    m_Metadata:
      m_Items: []
  - m_Id: 274694820323335
    m_Localized: Volver
    m_Metadata:
      m_Items: []
  - m_Id: 274694820323336
    m_Localized: "\xA1Nueva opci\xF3n disponible!"
    m_Metadata:
      m_Items: []
  - m_Id: 274694820323337
    m_Localized: "\xA1As\xED queda tu explorador!"
    m_Metadata:
      m_Items: []
  - m_Id: 274694820323338
    m_Localized: "Probemos otra combinaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 274694820323339
    m_Localized: "Esta opci\xF3n todav\xEDa no est\xE1 disponible."
