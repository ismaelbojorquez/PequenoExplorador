  m_TableData:
  - m_Id: 116383744
    m_Localized: "DIAGN\xD3STICO TEMPORAL \xB7 SIN GAMEPLAY"
    m_Metadata:
      m_Items: []
  - m_Id: 116383745
    m_Localized: "Preparando la aventura\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 116383746
    m_Localized: Listo
    m_Metadata:
      m_Items: []
  - m_Id: 116383747
    m_Localized: "Listo \xB7 Recuperamos tu progreso"
    m_Metadata:
      m_Items: []
  - m_Id: 116383748
    m_Localized: "Listo \xB7 Tu progreso nuevo est\xE1 protegido"
    m_Metadata:
      m_Items: []
  - m_Id: 116383749
    m_Localized: "No pudimos iniciar \xB7 Puedes intentar otra vez"
    m_Metadata:
      m_Items: []
  - m_Id: 116383750
    m_Localized: Pausado
    m_Metadata:
      m_Items: []
  - m_Id: 116383751
    m_Localized: "No pudimos cambiar de lugar \xB7 Puedes intentar otra vez"
    m_Metadata:
      m_Items: []
  - m_Id: 116383752
    m_Localized: "Preparando {0}\u2026"
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 116383753
    m_Localized: Ir a la selva
    m_Metadata:
      m_Items: []
  - m_Id: 116383754
    m_Localized: Volver al campamento
    m_Metadata:
      m_Items: []
  - m_Id: 116383755
    m_Localized: Intentar otra vez
    m_Metadata:
      m_Items: []
  - m_Id: 116383756
    m_Localized: Simular fallo
    m_Metadata:
      m_Items: []
  - m_Id: 116383757
    m_Localized: "Espa\xF1ol"
    m_Metadata:
      m_Items: []
  - m_Id: 116383758
    m_Localized: "Ingl\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 116383759
    m_Localized: Pseudo
    m_Metadata:
      m_Items: []
  - m_Id: 23092213571600
    m_Localized: Pausa tranquila
    m_Metadata:
      m_Items: []
  - m_Id: 23092213571601
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 49203240755200
    m_Localized: "Este lugar todav\xEDa no est\xE1 disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 49203265921024
    m_Localized: "Este lugar ya no est\xE1 disponible. Tu progreso sigue seguro."
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000001
    m_Localized: Vamos a acercarnos.
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000002
    m_Localized: Mirar de cerca
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000003
    m_Localized: Ahora no
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000004
    m_Localized: "Todav\xEDa no podemos mirar esto. Probemos con otra cosa."
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000005
    m_Localized: "\xA1Lo vimos de cerca!"
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000006
    m_Localized: Esperemos un momento para volver a mirar.
    m_Metadata:
      m_Items: []
  - m_Id: 77211267751936
    m_Localized: "\xA1Nuevo descubrimiento!"
    m_Metadata:
      m_Items: []
  - m_Id: 77211284529152
