  m_TableData:
  - m_Id: 116383744
    m_Localized: "DIAGN\xD3STICO TEMPORAL \xB7 SIN GAMEPLAY"
    m_Metadata:
      m_Items: []
  - m_Id: 116383745
    m_Localized: "Preparando la aventura\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 116383746
    m_Localized: Listo
    m_Metadata:
      m_Items: []
  - m_Id: 116383747
    m_Localized: "Listo \xB7 Recuperamos tu progreso"
    m_Metadata:
      m_Items: []
  - m_Id: 116383748
    m_Localized: "Listo \xB7 Tu progreso nuevo est\xE1 protegido"
    m_Metadata:
      m_Items: []
  - m_Id: 116383749
    m_Localized: "No pudimos iniciar \xB7 Puedes intentar otra vez"
    m_Metadata:
      m_Items: []
  - m_Id: 116383750
    m_Localized: Pausado
    m_Metadata:
      m_Items: []
  - m_Id: 116383751
    m_Localized: "No pudimos cambiar de lugar \xB7 Puedes intentar otra vez"
    m_Metadata:
      m_Items: []
  - m_Id: 116383752
    m_Localized: "Preparando {0}\u2026"
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 116383753
    m_Localized: Ir a la selva
    m_Metadata:
      m_Items: []
  - m_Id: 116383754
    m_Localized: Volver al campamento
    m_Metadata:
      m_Items: []
  - m_Id: 116383755
    m_Localized: Intentar otra vez
    m_Metadata:
      m_Items: []
  - m_Id: 116383756
    m_Localized: Simular fallo
    m_Metadata:
      m_Items: []
  - m_Id: 116383757
    m_Localized: "Espa\xF1ol"
    m_Metadata:
      m_Items: []
  - m_Id: 116383758
    m_Localized: "Ingl\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 116383759
    m_Localized: Pseudo
    m_Metadata:
      m_Items: []
  - m_Id: 23092213571600
    m_Localized: Pausa tranquila
    m_Metadata:
      m_Items: []
  - m_Id: 23092213571601
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 49203240755200
    m_Localized: "Este lugar todav\xEDa no est\xE1 disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 49203265921024
    m_Localized: "Este lugar ya no est\xE1 disponible. Tu progreso sigue seguro."
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000001
    m_Localized: Vamos a acercarnos.
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000002
    m_Localized: Mirar de cerca
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000003
    m_Localized: Ahora no
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000004
    m_Localized: "Todav\xEDa no podemos mirar esto. Probemos con otra cosa."
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000005
    m_Localized: "\xA1Lo vimos de cerca!"
    m_Metadata:
      m_Items: []
  - m_Id: 70000000000006
    m_Localized: Esperemos un momento para volver a mirar.
    m_Metadata:
      m_Items: []
  - m_Id: 77211267751936
    m_Localized: "\xA1Nuevo descubrimiento!"
    m_Metadata:
      m_Items: []
  - m_Id: 77211284529152
    m_Localized: "\xA1Lo observaste otra vez!"
    m_Metadata:
      m_Items: []
  - m_Id: 77211284529153
    m_Localized: "{0} \xB7 Observaciones: {1}"
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 197791753166848
    m_Localized: Vamos a tomar una foto.
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721280
    m_Localized: "Ac\xE9rcate un poquito."
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721281
    m_Localized: "Pon al tuc\xE1n dentro del marco."
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721282
    m_Localized: "\xA1Listo para la foto!"
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721283
    m_Localized: Foto
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721284
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 197791786721285
    m_Localized: Casi. Probemos desde otro lugar.
    m_Metadata:
      m_Items: []
  - m_Id: 197791790915584
    m_Localized: "\xA1Nuevo descubrimiento!"
    m_Metadata:
      m_Items: []
  - m_Id: 197791790915585
    m_Localized: "\xA1Qu\xE9 buena observaci\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 197791790915586
    m_Localized: "\xA1Descubrimiento guardado! Usaremos su ilustraci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 210606312382464
    m_Localized: "\xC1lbum"
    m_Metadata:
      m_Items: []
  - m_Id: 210606345936896
    m_Localized: "\xC1lbum de la Selva"
    m_Metadata:
      m_Items: []
  - m_Id: 210606345936897
    m_Localized: Volver
    m_Metadata:
      m_Items: []
  - m_Id: 210606345936898
    m_Localized: Por descubrir
    m_Metadata:
      m_Items: []
  - m_Id: 210606350131200
    m_Localized: Explora la selva para encontrarlo.
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325504
    m_Localized: Descubierto
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325505
    m_Localized: '{0}: {1} de {2}'
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 210606354325506
    m_Localized: 'Encontrados: {0} de {1}'
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 210606354325507
    m_Localized: "Preparando el \xE1lbum\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325508
    m_Localized: "Todav\xEDa no hay entradas aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325509
    m_Localized: "No pudimos abrir esta p\xE1gina. Puedes volver e intentar otra
      vez."
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325510
    m_Localized: "P\xE1gina {0} de {1}"
    m_Metadata:
      m_Items:
      - rid: 6219209779658358817
  - m_Id: 210606354325511
    m_Localized: Anterior
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325512
    m_Localized: Siguiente
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325513
    m_Localized: "D\xF3nde vive"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325514
    m_Localized: "Qu\xE9 come"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325515
    m_Localized: "Tama\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325516
    m_Localized: Algo curioso
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325517
    m_Localized: "C\xF3mo suena"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325518
    m_Localized: "Este dato est\xE1 por confirmar."
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325519
    m_Localized: Escuchar otra vez
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325520
    m_Localized: Audio por preparar
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325521
    m_Localized: "Buscando tu mejor foto\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325522
    m_Localized: "Usamos su imagen del \xE1lbum."
    m_Metadata:
      m_Items: []
  - m_Id: 210606354325523
    m_Localized: Tu mejor foto
    m_Metadata:
      m_Items: []
