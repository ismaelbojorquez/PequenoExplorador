    m_Localized: Listen again
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515788
    m_Localized: Exit
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515789
    m_Localized: You can come back whenever you like.
    m_Metadata:
      m_Items: []
  - m_Id: 251180197339136
