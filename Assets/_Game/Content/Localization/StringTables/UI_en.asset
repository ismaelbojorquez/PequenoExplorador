    m_Metadata:
      m_Items: []
  - m_Id: 241337885515777
    m_Localized: You found it!
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515778
    m_Localized: "Let\u2019s look again. You can try once more."
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515779
    m_Localized: Look for the round shape.
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515780
    m_Localized: It has no corners.
    m_Metadata:
      m_Items: []
  - m_Id: 241337885515781
    m_Localized: This is the circle. You can tap it.
    m_Metadata:
      m_Items: []
