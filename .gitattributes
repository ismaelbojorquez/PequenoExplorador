# Repository text policy
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unity serialized YAML: stable text diffs and prepared merge driver.
*.unity text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.prefab text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.asset text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.mat text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.anim text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.controller text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.overrideController text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.meta text eol=lf whitespace=-trailing-space

# Large binary asset types are ready for Git LFS. No binary is added in Phase 00.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.aif filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text

# NavMeshData is a Unity native binary despite its .asset extension.
Assets/_Game/Content/Explorer/PH_Jungle_NavMesh.asset -text -diff -merge
